# アップロード画像の置き場。画像以外は一切返さない（PHP なども実行させない）
Options -Indexes
<FilesMatch "\.(?i:jpe?g|png|webp|gif)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>
<FilesMatch "^(?!.*\.(?i:jpe?g|png|webp|gif)$).*$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
