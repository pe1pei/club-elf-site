# CLUB ELF サイト（さくらのレンタルサーバ / Apache 用）
# ※ http → https の転送は、さくらのコントロールパネルの「常時SSL化」で設定する

DirectoryIndex page.php
Options -Indexes

# 設定・データ・作業用のファイルは、どのフォルダにあっても直接開かせない
<FilesMatch "(^\.|\.(json|tmp|bak|log|md|sh|ini|lock)$|^composer\.)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On

# 公開ページ（検索・SNS 向けの情報を PHP で埋め込んで返す）
RewriteRule ^$ page.php?p=index [L,QSA]
RewriteRule ^index\.html$ page.php?p=index [L,QSA]
RewriteRule ^recruit(\.html)?$ page.php?p=recruit [L,QSA]
RewriteRule ^sitemap\.xml$ page.php?p=sitemap [L]
RewriteRule ^robots\.txt$ page.php?p=robots [L]

# 管理画面
RewriteRule ^admin$ %{REQUEST_URI}/ [R=301,L]
RewriteRule ^admin/(index\.html)?$ page.php?p=admin [L,QSA]

# 管理画面用 API
RewriteRule ^api/(.*)$ api/index.php?r=$1 [L,QSA]
</IfModule>

# セキュリティ用のヘッダー
<IfModule mod_headers.c>
  # 他のサイトの枠（iframe）の中に表示させない（管理画面を隠して押させる「クリックジャッキング」対策。プレビューは同じサイトなのでOK）
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  # ファイルの種類を勝手に推測させない
  Header always set X-Content-Type-Options "nosniff"
  # 他のサイトへ移動するとき、ページの URL を全部は渡さない
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # カメラ・マイク・位置情報などは使わない
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # 一度来たブラウザには、以後ずっと https で接続させる
  Header always set Strict-Transport-Security "max-age=31536000"
  # PHP のバージョンを外に見せない
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# 画像・JS・CSS は少し長めにキャッシュ（JS/CSS は更新時に URL が変わる）
<IfModule mod_headers.c>
<FilesMatch "\.(jpe?g|png|webp|gif|svg)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
</IfModule>
