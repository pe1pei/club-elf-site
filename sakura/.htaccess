# CLUB ELF サイト（さくらのレンタルサーバ / Apache 用）
# ※ http → https の転送は、さくらのコントロールパネルの「常時SSL化」で設定する

DirectoryIndex page.php
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# 公開ページ（検索・SNS 向けの情報を PHP で埋め込んで返す）
RewriteRule ^$ page.php?p=index [L,QSA]
RewriteRule ^index\.html$ page.php?p=index [L,QSA]
RewriteRule ^recruit(\.html)?$ page.php?p=recruit [L,QSA]
RewriteRule ^sitemap\.xml$ page.php?p=sitemap [L]
RewriteRule ^robots\.txt$ page.php?p=robots [L]

# 管理画面
RewriteRule ^admin$ %{REQUEST_URI}/ [R=301,L]
RewriteRule ^admin/(index\.html)?$ page.php?p=admin [L,QSA]

# 管理画面用 API
RewriteRule ^api/(.*)$ api/index.php?r=$1 [L,QSA]
</IfModule>

# 画像・JS・CSS は少し長めにキャッシュ（JS/CSS は更新時に URL が変わる）
<IfModule mod_headers.c>
<FilesMatch "\.(jpe?g|png|webp|gif|svg)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
</IfModule>
